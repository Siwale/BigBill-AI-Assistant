{
  "name": "bigbill-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone, multi-tenant executive assistant with text and real voice.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src worker scripts tests --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "setup:local": "node scripts/local-setup.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.56.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.2",
    "ioredis": "^5.6.1",
    "jose": "^6.0.11",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "openai": "^5.8.2",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.187.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.2",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
