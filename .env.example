# Copy to .env.local and fill locally. Never commit real values.
DATABASE_URL=postgres://assistant:assistant_local_dev@127.0.0.1:5437/assistant
REDIS_URL=redis://127.0.0.1:6384
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Model gateway (provider-neutral adapter; one of openai | deepseek | openrouter)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Speech (optional server fallback; browser speech is the primary path)
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
EMBEDDING_MODEL=text-embedding-3-small

APP_URL=http://localhost:3000
NODE_ENV=development

# Optional: HMAC secret for the synthetic webhook ingress. Disabled when empty.
WEBHOOK_SHARED_SECRET=
